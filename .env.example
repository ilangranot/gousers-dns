# ── Local environment (docker-compose) ────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to version control.
# Prod uses AWS Secrets Manager — see infrastructure/terraform/secrets.tf

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aigateway

# Redis
REDIS_URL=redis://redis:6379

# Auth.js (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000

# API URL visible to the browser (local docker-compose)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Allowed CORS origins for the API
CORS_ORIGINS=http://localhost:3000

# Encryption key for GPT API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# App
APP_ENV=local
APP_BASE_URL=http://localhost:3000

# Email backend: "log" (print link to stdout), "ses" (AWS SES), "smtp" (generic SMTP)
# For local SES: set EMAIL_BACKEND=ses and ensure ~/.aws credentials are configured
# (docker-compose mounts ~/.aws:/root/.aws:ro automatically)
# Alternatively, set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY below.
EMAIL_BACKEND=log
SES_FROM_EMAIL=noreply@gousers.com
SES_REGION=us-east-1
# AWS credentials (optional — used only when EMAIL_BACKEND=ses locally)
# If you use AWS SSO or a profile, leave these blank and rely on ~/.aws
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# For local SMTP testing (EMAIL_BACKEND=smtp):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
